{
  "name": "fenrir-ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "type-check": "tsc --noEmit",
    "types": "tsc -p tsconfig.types.json",
    "types:bundle": "dts-bundle-generator -o public/fenrir.d.ts --external-imports=three --no-banner src/core/index.ts",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --watch",
    "test:ci": "vitest run --reporter=verbose --coverage"
  },
  "devDependencies": {
    "@types/node": "^25.0.6",
    "@vitest/coverage-v8": "4.0.16",
    "dts-bundle-generator": "^9.5.1",
    "jsdom": "^27.4.0",
    "typescript": "~5.9.3",
    "vite": "npm:rolldown-vite@7.2.5",
    "vite-plugin-vercel": "^9.1.1",
    "vitest": "^4.0.16"
  },
  "pnpm": {
    "overrides": {
      "vite": "npm:rolldown-vite@7.2.5"
    }
  },
  "dependencies": {
    "@types/three": "^0.182.0",
    "jolt-physics": "^1.0.0",
    "monaco-editor": "0.55.1",
    "three": "^0.182.0"
  }
}

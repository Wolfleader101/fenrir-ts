{
  "name": "fenrir-ts",
  "version": "0.1.0",
  "type": "module",
  "description": "A TypeScript game engine with ECS architecture",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "import": "./dist/editor.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && npm run build:demos",
    "build:lib": "vite build --config vite.config.lib.ts",
    "build:demos": "vite build",
    "type-check": "tsc --noEmit",
    "types:bundle": "dts-bundle-generator -o public/fenrir.d.ts --external-imports=three --no-banner src/core/index.ts",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --watch",
    "test:ci": "vitest run --reporter=verbose --coverage",
    "prepublishOnly": "npm run test:run && npm run build:lib"
  },
  "keywords": [
    "game-engine",
    "ecs",
    "typescript",
    "three.js",
    "pixi.js",
    "2d",
    "3d",
    "physics",
    "jolt"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": ""
  },
  "peerDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "jolt-physics": "^1.0.0",
    "monaco-editor": "0.55.1",
    "pixi.js": "^8.0.0",
    "tailwindcss": "^4.1.18",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.6",
    "@types/three": "^0.182.0",
    "@vitest/coverage-v8": "4.0.16",
    "dts-bundle-generator": "^9.5.1",
    "jsdom": "^27.4.0",
    "postcss-lit": "^1.3.1",
    "typescript": "~5.9.3",
    "vite": "npm:rolldown-vite@7.2.5",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-vercel": "^9.1.1",
    "vitest": "^4.0.16"
  },
  "pnpm": {
    "overrides": {
      "vite": "npm:rolldown-vite@7.2.5"
    }
  },
  "dependencies": {
    "@lit-labs/signals": "^0.2.0",
    "@tailwindcss/postcss": "^4.1.18",
    "lit": "^3.3.2",
    "lit-html": "^3.3.2",
    "lucide": "^0.563.0",
    "pixi.js": "^8.16.0",
    "postcss": "^8.5.6",
    "signal-polyfill": "^0.2.2",
    "signal-utils": "^0.21.1"
  }
}
